# Plantilla de variables de entorno (versionada, sin secretos).
# Copiar a .env para desarrollo local: cp .env.example .env
# Coherente con Dockerfile:11 (NODE_ENV) y Dockerfile:16 (PORT).
PORT=3000
NODE_ENV=production

# PostgreSQL gestionado por Dokploy en la infraestructura de la universidad
# (ADR-0014). Solo en el entorno de despliegue (secretos de Azure Container
# Apps); nunca versionada ni con valores reales en este archivo.
DATABASE_URL=


# Secreto para firmar los tokens de sesión (ADR-0021). OBLIGATORIO en
# producción, mínimo 32 caracteres aleatorios; sin él el login responde error.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Dominios de correo admitidos en el registro, separados por coma.
# Por defecto solo la UTB.
DOMINIOS_CORREO=utb.edu.co
# Cuentas del personal de las tiendas (ADR-0023). No hay registro abierto: se
# declaran aquí y se crean al arrancar si no existen (nunca se sobrescriben).
# Formato: tiendaId|rol|correo|contraseña|Nombre separados por ;
# rol = admin (precios, ventas) o trabajador (pedidos y agotados).
# Ejemplo: tienda-01|admin|admin.meson@ejemplo.co|<contraseña>|Admin Mesón
CUENTAS_TIENDA=

# Almacén de imágenes (ADR-0028): Garage S3 en la red interna de Dokploy.
# SIN estas variables el sistema corre en modo memoria (las imágenes no
# sobreviven reinicios — declarado). HTTP interno: TLS lo termina Traefik.
# GARAGE_API_URL=http://garage:3900
# GARAGE_REGION=garage
# GARAGE_BUCKET=imagenes
# GARAGE_ACCESS_KEY_ID=
# GARAGE_SECRET_ACCESS_KEY=
