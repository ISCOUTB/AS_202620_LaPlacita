# Laboratorio local de seguridad (S14). Plantilla sin secretos.
# `lab.sh preparar` genera .env.local con valores aleatorios.
POSTGRES_DB=laplacita
POSTGRES_USER=laplacita
POSTGRES_PASSWORD=
DATABASE_URL=postgres://laplacita:CAMBIAR@127.0.0.1:5433/laplacita

JWT_SECRET=
DOMINIOS_CORREO=lab.test
CUENTAS_TIENDA="tienda-01|admin|admin.meson@lab.test|CAMBIAR|Admin Meson;tienda-01|trabajador|caja.meson@lab.test|CAMBIAR|Caja Meson;tienda-02|admin|admin.asa@lab.test|CAMBIAR|Admin Asao"
ADMINS_GENERALES=superadmin@lab.test

LAB_ADMIN_EMAIL=superadmin@lab.test
LAB_ADMIN_PASSWORD=
LAB_CLIENTE_EMAIL=cliente.lab@lab.test
LAB_CLIENTE_PASSWORD=
LAB_TIENDA01_EMAIL=admin.meson@lab.test
LAB_TIENDA01_PASSWORD=
LAB_TIENDA02_EMAIL=admin.asa@lab.test
LAB_TIENDA02_PASSWORD=

PORT_BACKEND=3100
PORT_FRONTEND=3200
BACKEND_URL=http://127.0.0.1:3100
LAB_BACKEND=http://127.0.0.1:3100
LAB_FRONTEND=http://127.0.0.1:3200
